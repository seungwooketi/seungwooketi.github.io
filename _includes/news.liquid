<div class="news">
  {% comment %} Pin manual announcements (_news) on top, then fill remaining slots with recent blog posts {% endcomment %}
  {% assign manual_news = site.news | sort: 'date' | reverse %}
  {% assign blog_posts = site.posts | sort: 'date' | reverse %}
  {% assign combined = manual_news | concat: blog_posts %}
  {% if combined != blank %}
    {% assign news_size = combined | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = combined %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% if item.collection == 'posts' %}
                  <span class="badge text-bg-light ms-1">new post</span>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
