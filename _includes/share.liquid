{% assign share_url = page.url | absolute_url %}
{% if page.lang == 'ko' %}
  {% assign l_share = '공유' %}
  {% assign l_email = '이메일' %}
  {% assign l_copy = '링크 복사' %}
  {% assign l_copied = '복사됨 ✓' %}
{% else %}
  {% assign l_share = 'Share' %}
  {% assign l_email = 'Email' %}
  {% assign l_copy = 'Copy link' %}
  {% assign l_copied = 'Copied ✓' %}
{% endif %}
<div class="bp-share">
  <span class="bp-share-label">{{ l_share }}</span>
  <a
    class="bp-share-btn"
    href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url | url_encode }}"
    target="_blank"
    rel="noopener noreferrer"
    >LinkedIn</a
  >
  <a
    class="bp-share-btn"
    href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ page.title | url_encode }}"
    target="_blank"
    rel="noopener noreferrer"
    >X</a
  >
  <a class="bp-share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener noreferrer"
    >Facebook</a
  >
  <a class="bp-share-btn" href="mailto:?subject={{ page.title | url_encode }}&body={{ share_url | url_encode }}">{{ l_email }}</a>
  <button class="bp-share-btn bp-share-copy" type="button" data-copied="{{ l_copied }}">{{ l_copy }}</button>
</div>
<script>
  (function () {
    var btn = document.querySelector(".bp-share-copy");
    if (!btn) return;
    var url = {{ share_url | jsonify }};
    var label = btn.textContent;
    btn.addEventListener("click", function () {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(url).then(function () {
        btn.textContent = btn.getAttribute("data-copied");
        setTimeout(function () {
          btn.textContent = label;
        }, 1500);
      });
    });
  })();
</script>
